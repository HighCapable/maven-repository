    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/BetterAndroid/android-notification-icon-project.git</connection>
    <developerConnection>scm:git:ssh://github.com/BetterAndroid/android-notification-icon-project.git</developerConnection>
    <url>https://github.com/BetterAndroid/android-notification-icon-project</url>
  </scm>
  <dependencyManagement>
    <dependencies>
      <dependency>
